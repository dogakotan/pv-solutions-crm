# PV Solutions CRM — ortam değişkenleri örneği
#
# ÖNEMLİ: Bu dosyada ve NEXT_PUBLIC_ ile başlayan hiçbir değişkende
# service_role veya başka bir secret key BULUNMAMALIDIR.
# service_role key yalnızca sunucu tarafı, NEXT_PUBLIC_ olmayan bir
# değişken olarak (örn. SUPABASE_SERVICE_ROLE_KEY) ve yalnızca
# gerçekten gerekli olan sunucu-only işlemlerde (ör. Faz 1 kullanıcı
# davet/oluşturma) kullanılmalı, hiçbir zaman client bundle'a girmemelidir.

# Supabase proje URL'i (tarayıcıya açık, güvenli)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase publishable/anon key (tarayıcıya açık, güvenli — RLS ile korunur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Uygulamanın kendi URL'i (şifre sıfırlama e-postasındaki bağlantıyı
# oluşturmak için kullanılır). Prod'da gerçek domain ile değiştirilmeli.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sunucu tarafı, yalnızca gerektiğinde ---
# Partner çalışan hesabı oluşturma (Auth Admin API) bunu gerektirir.
# Supabase Dashboard > Project Settings > API > service_role secret.
# NEXT_PUBLIC_ öneki YOK, asla client'a gönderilmez.
# SUPABASE_SERVICE_ROLE_KEY=

# --- E2E testleri (Playwright, `npm run test:e2e`) ---
# Kimlik doğrulanmış akışları test edebilmek için kalıcı bir test
# kullanıcısı gerekir; bu repo hiçbir test hesabı otomatik OLUŞTURMAZ.
# Kendi Supabase projenizde bir test hesabı açıp (pv_admin rolüyle —
# gerçek admin hesabınızı DEĞİL, ayrı bir "e2e-test@..." hesabı) bilgilerini
# buraya girmezseniz, sadece login/redirect gibi anonim testler çalışır,
# kimlik doğrulanmış testler otomatik atlanır.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
#
# lead/partner/teklif/çalışan oluşturma testleri (e2e/lead-creation.spec.ts
# vb.) test verisini oluşturduktan sonra service-role client ile temizler —
# bu yüzden yukarıdaki SUPABASE_SERVICE_ROLE_KEY de bu testler için gerekli,
# tanımlı değilse bu testler de otomatik atlanır.
#
# Diğer rollerin kendi kalıcı test hesapları (şu an hiçbir e2e testi
# bunları kullanmıyor — sadece manuel doğrulama / ileride yazılacak
# rol-bazlı testler için). E2E_TEST_* aynı pv_admin hesabıdır.
# FIRST_CALL_TEST_EMAIL=
# FIRST_CALL_TEST_PASSWORD=
# SALES_TEST_EMAIL=
# SALES_TEST_PASSWORD=
# PARTNER_ADMIN_TEST_EMAIL=
# PARTNER_ADMIN_TEST_PASSWORD=
# PARTNER_EMPLOYEE_TEST_EMAIL=
# PARTNER_EMPLOYEE_TEST_PASSWORD=
